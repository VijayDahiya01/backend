# Server Configuration
PORT=3000
NODE_ENV=development
# The base URL for the backend API (e.g., http://localhost:3000 or https://api.example.com)
BASE_URL=http://localhost:3000
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage Configuration
# Directory to store recordings and other files. 
# Ensure this directory exists and is writable.
STORAGE_ROOT=storage

# Twilio Configuration
# Found in Twilio Console Dashboard
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
# The phone number purchased from Twilio
TWILIO_PHONE_NUMBER=+1234567890

# OpenAI Configuration
# API Key for OpenAI (GPT-4, Whisper, etc.)
OPENAI_API_KEY=sk-...

# Voice Configuration (Optional)
# Default voice settings if not provided in the request
# DEFAULT_VOICE_ID=alloy
# DEFAULT_VOICE_SPEED=1.0
